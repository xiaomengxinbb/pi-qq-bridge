{
  "name": "pi-qq-bridge",
  "version": "0.1.3",
  "description": "Pi extension: bidirectional QQ bridge (C2C + group) with isolated agent sessions and /workspace support.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "qq",
    "qqbot",
    "qq-bot",
    "coding-agent"
  ],
  "files": [
    "src",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "prepack": "npm test",
    "spike": "node --experimental-strip-types scripts/spike-sdk.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.82.0 <1.0.0"
  },
  "engines": {
    "node": ">=22.19"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "typebox": "^1.1.38",
    "unpdf": "^1.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaomengxinbb/pi-qq-bridge.git"
  },
  "homepage": "https://github.com/xiaomengxinbb/pi-qq-bridge#readme",
  "bugs": {
    "url": "https://github.com/xiaomengxinbb/pi-qq-bridge/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
